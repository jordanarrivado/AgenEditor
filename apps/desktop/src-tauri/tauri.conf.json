{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgenEditor",
  "version": "0.1.0",
  "identifier": "com.ageneditor.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev",
    "beforeBuildCommand": "npm --prefix ../.. run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "AgenEditor Alpha",
      "width": 1440,
      "height": 900,
      "minWidth": 1100,
      "minHeight": 700
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/projects/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/ageneditor-engine"],
    "resources": ["binaries/ffmpeg.exe", "binaries/ffprobe.exe", "resources/third-party/", "resources/fonts/"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
