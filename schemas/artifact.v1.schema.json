{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "preview_render",
        "final_render",
        "captions_srt",
        "qa_report"
      ],
      "title": "ArtifactKind",
      "type": "string"
    }
  },
  "$id": "https://ageneditor.local/schemas/artifact.v1.json",
  "additionalProperties": false,
  "properties": {
    "clip_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clip Id"
    },
    "created_by_attempt": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By Attempt"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ArtifactKind"
    },
    "profile_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profile Hash"
    },
    "relative_path": {
      "maxLength": 400,
      "title": "Relative Path",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "timeline_revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeline Revision"
    },
    "verified_at": {
      "format": "date-time",
      "title": "Verified At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "kind",
    "relative_path",
    "sha256",
    "size_bytes"
  ],
  "title": "Artifact",
  "type": "object"
}
