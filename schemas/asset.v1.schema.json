{
  "$defs": {
    "AssetKind": {
      "enum": [
        "video",
        "audio",
        "image",
        "subtitle"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetRole": {
      "description": "What the user registered the asset as. Only these may appear in a timeline.",
      "enum": [
        "primary",
        "broll",
        "music",
        "logo",
        "subtitles"
      ],
      "title": "AssetRole",
      "type": "string"
    },
    "AudioStream": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "exclusiveMinimum": 0,
          "title": "Channels",
          "type": "integer"
        },
        "codec": {
          "title": "Codec",
          "type": "string"
        },
        "duration_samples": {
          "minimum": 0,
          "title": "Duration Samples",
          "type": "integer"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "sample_rate": {
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "start_pts": {
          "default": 0,
          "title": "Start Pts",
          "type": "integer"
        },
        "time_base_den": {
          "exclusiveMinimum": 0,
          "title": "Time Base Den",
          "type": "integer"
        },
        "time_base_num": {
          "exclusiveMinimum": 0,
          "title": "Time Base Num",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "codec",
        "sample_rate",
        "channels",
        "time_base_num",
        "time_base_den",
        "duration_samples"
      ],
      "title": "AudioStream",
      "type": "object"
    },
    "FrameRate": {
      "description": "Exact rational frame rate, e.g. 30/1 or 30000/1001.",
      "properties": {
        "den": {
          "default": 1,
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Den",
          "type": "integer"
        },
        "num": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Num",
          "type": "integer"
        }
      },
      "required": [
        "num"
      ],
      "title": "FrameRate",
      "type": "object"
    },
    "VideoStream": {
      "additionalProperties": false,
      "properties": {
        "avg_frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "codec": {
          "title": "Codec",
          "type": "string"
        },
        "duration_frames": {
          "minimum": 0,
          "title": "Duration Frames",
          "type": "integer"
        },
        "frame_rate": {
          "$ref": "#/$defs/FrameRate"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "is_vfr": {
          "default": false,
          "title": "Is Vfr",
          "type": "boolean"
        },
        "pixel_format": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pixel Format"
        },
        "rotation_degrees": {
          "default": 0,
          "title": "Rotation Degrees",
          "type": "integer"
        },
        "start_pts": {
          "default": 0,
          "title": "Start Pts",
          "type": "integer"
        },
        "time_base_den": {
          "exclusiveMinimum": 0,
          "title": "Time Base Den",
          "type": "integer"
        },
        "time_base_num": {
          "exclusiveMinimum": 0,
          "title": "Time Base Num",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "codec",
        "width",
        "height",
        "frame_rate",
        "time_base_num",
        "time_base_den",
        "duration_frames"
      ],
      "title": "VideoStream",
      "type": "object"
    }
  },
  "$id": "https://ageneditor.local/schemas/asset.v1.json",
  "additionalProperties": false,
  "properties": {
    "audio": {
      "anyOf": [
        {
          "$ref": "#/$defs/AudioStream"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "container": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Container"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "imported_at": {
      "format": "date-time",
      "title": "Imported At",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/AssetKind"
    },
    "labels": {
      "items": {
        "maxLength": 60,
        "minLength": 1,
        "pattern": "^[\\w][\\w \\-']*$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Labels",
      "type": "array"
    },
    "original_filename": {
      "maxLength": 255,
      "title": "Original Filename",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "relative_path": {
      "title": "Relative Path",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/AssetRole"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "video": {
      "anyOf": [
        {
          "$ref": "#/$defs/VideoStream"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "project_id",
    "kind",
    "role",
    "relative_path",
    "original_filename",
    "sha256",
    "size_bytes"
  ],
  "title": "Asset",
  "type": "object"
}
