{
  "$defs": {
    "AcceptedIssue": {
      "additionalProperties": false,
      "description": "A person's decision to use a linked file despite a known problem.",
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "note"
      ],
      "title": "AcceptedIssue",
      "type": "object"
    },
    "AssetRequest": {
      "additionalProperties": false,
      "properties": {
        "aspect": {
          "default": "9:16",
          "maxLength": 32,
          "minLength": 1,
          "title": "Aspect",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "prompt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "purpose": {
          "default": "",
          "maxLength": 500,
          "title": "Purpose",
          "type": "string"
        },
        "variant_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Id"
        }
      },
      "required": [
        "id",
        "kind",
        "prompt"
      ],
      "title": "AssetRequest",
      "type": "object"
    },
    "ReviewNote": {
      "additionalProperties": false,
      "description": "A person's note on an approved file, written while checking it against the brief.\n\nAgents read it (for example \"use only the first 3 seconds\"); it belongs to the exact file approved.",
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "text"
      ],
      "title": "ReviewNote",
      "type": "object"
    }
  },
  "$id": "https://ageneditor.local/schemas/asset_checklist.v1.json",
  "additionalProperties": false,
  "properties": {
    "accepted": {
      "patternProperties": {
        "^[a-z0-9][a-z0-9_\\-]{0,63}$": {
          "$ref": "#/$defs/AcceptedIssue"
        }
      },
      "title": "Accepted",
      "type": "object"
    },
    "approved": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Approved",
      "type": "array"
    },
    "configured": {
      "default": false,
      "title": "Configured",
      "type": "boolean"
    },
    "links": {
      "patternProperties": {
        "^[a-z0-9][a-z0-9_\\-]{0,63}$": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
              "type": "string"
            },
            {
              "const": "dropped",
              "type": "string"
            }
          ]
        }
      },
      "title": "Links",
      "type": "object"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "requests": {
      "items": {
        "$ref": "#/$defs/AssetRequest"
      },
      "maxItems": 100,
      "title": "Requests",
      "type": "array"
    },
    "review_notes": {
      "patternProperties": {
        "^[a-z0-9][a-z0-9_\\-]{0,63}$": {
          "$ref": "#/$defs/ReviewNote"
        }
      },
      "title": "Review Notes",
      "type": "object"
    },
    "review_required": {
      "default": false,
      "title": "Review Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "default": 0,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "AssetChecklist",
  "type": "object"
}
