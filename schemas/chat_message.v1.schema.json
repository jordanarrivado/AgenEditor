{
  "$defs": {
    "ChatProvider": {
      "enum": [
        "anthropic",
        "openai",
        "gemini"
      ],
      "title": "ChatProvider",
      "type": "string"
    }
  },
  "$id": "https://ageneditor.local/schemas/chat_message.v1.json",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9._:\\-/]{1,100}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "proposal_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposal Id"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatProvider"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "role": {
      "enum": [
        "user",
        "assistant",
        "system"
      ],
      "title": "Role",
      "type": "string"
    },
    "text": {
      "maxLength": 20000,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "id",
    "project_id",
    "role",
    "text"
  ],
  "title": "ChatMessage",
  "type": "object"
}
