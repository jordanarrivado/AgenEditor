{
  "$defs": {
    "TaskType": {
      "description": "Smallest schedulable unit types (spec \u00a77). Batch-level tasks have no clip.",
      "enum": [
        "analyze_source",
        "discover_clips",
        "plan_clip",
        "structural_edit",
        "captions",
        "visual_polish",
        "audio_polish",
        "enhancement",
        "assemble_draft",
        "render_preview",
        "technical_qa",
        "editorial_qa",
        "revision",
        "export"
      ],
      "title": "TaskType",
      "type": "string"
    }
  },
  "$id": "https://ageneditor.local/schemas/checkpoint.v1.json",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Id"
    },
    "attempt_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "input_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Fingerprint",
      "type": "string"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "scope_key": {
      "maxLength": 120,
      "title": "Scope Key",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "task_type": {
      "$ref": "#/$defs/TaskType"
    },
    "valid": {
      "default": true,
      "title": "Valid",
      "type": "boolean"
    },
    "verified_at": {
      "format": "date-time",
      "title": "Verified At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "task_type",
    "scope_key",
    "input_fingerprint",
    "task_id",
    "result"
  ],
  "title": "CheckpointDescriptor",
  "type": "object"
}
