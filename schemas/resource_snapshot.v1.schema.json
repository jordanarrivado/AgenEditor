{
  "$defs": {
    "PoolState": {
      "additionalProperties": false,
      "properties": {
        "capacity": {
          "minimum": 0,
          "title": "Capacity",
          "type": "integer"
        },
        "holders": {
          "items": {
            "type": "string"
          },
          "title": "Holders",
          "type": "array"
        },
        "in_use": {
          "minimum": 0,
          "title": "In Use",
          "type": "integer"
        }
      },
      "required": [
        "capacity",
        "in_use"
      ],
      "title": "PoolState",
      "type": "object"
    }
  },
  "$id": "https://ageneditor.local/schemas/resource_snapshot.v1.json",
  "additionalProperties": false,
  "properties": {
    "cpu_busy_permille": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cpu Busy Permille"
    },
    "cpu_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cpu Count"
    },
    "disk_free_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disk Free Bytes"
    },
    "measured_at": {
      "format": "date-time",
      "title": "Measured At",
      "type": "string"
    },
    "memory_available_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Available Bytes"
    },
    "memory_total_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Total Bytes"
    },
    "pools": {
      "additionalProperties": {
        "$ref": "#/$defs/PoolState"
      },
      "title": "Pools",
      "type": "object"
    }
  },
  "required": [
    "pools"
  ],
  "title": "ResourceSnapshot",
  "type": "object"
}
