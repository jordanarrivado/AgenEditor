{
  "$defs": {
    "BlockReason": {
      "enum": [
        "dependencies",
        "waiting_for_assets",
        "waiting_for_team",
        "waiting_for_approval",
        "budget",
        "no_capable_worker",
        "paused",
        "policy",
        "rate_limited"
      ],
      "title": "BlockReason",
      "type": "string"
    },
    "EngineError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "EngineError",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Structured error codes returned by engine services and MCP tools (spec \u00a76).",
      "enum": [
        "ASSET_NOT_FOUND",
        "RANGE_OUT_OF_BOUNDS",
        "REVISION_CONFLICT",
        "SOURCE_CHANGED",
        "UNSUPPORTED_CODEC",
        "RENDER_FAILED",
        "QA_FAILED",
        "PERMISSION_DENIED",
        "INVALID_TIMELINE",
        "PROBE_FAILED",
        "PROJECT_NOT_FOUND",
        "JOB_NOT_FOUND",
        "JOB_CANCELED",
        "INVALID_ARGUMENT",
        "TRANSCRIPTION_FAILED",
        "TRANSCRIPT_NOT_FOUND",
        "SOURCE_INSUFFICIENT",
        "PLAN_RETRY_LIMIT",
        "OUT_OF_CONTEXT",
        "INSUFFICIENT_DISK",
        "DOWNLOAD_FAILED",
        "LEASE_EXPIRED",
        "STALE_FENCE",
        "RATE_LIMITED",
        "PROVIDER_UNAVAILABLE",
        "BUDGET_EXCEEDED",
        "NO_CAPABLE_WORKER",
        "TASK_TIMEOUT",
        "ADAPTER_FAILED",
        "INVALID_STATE_TRANSITION",
        "APPROVAL_REQUIRED",
        "DELIVERY_FAILED",
        "HUMAN_DECISION_REQUIRED"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "TaskStatus": {
      "enum": [
        "created",
        "blocked",
        "ready",
        "leased",
        "running",
        "succeeded",
        "retry_wait",
        "needs_human",
        "failed",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "TaskType": {
      "description": "Smallest schedulable unit types (spec \u00a77). Batch-level tasks have no clip.",
      "enum": [
        "analyze_source",
        "discover_clips",
        "plan_clip",
        "structural_edit",
        "captions",
        "visual_polish",
        "audio_polish",
        "enhancement",
        "assemble_draft",
        "render_preview",
        "technical_qa",
        "editorial_qa",
        "revision",
        "export"
      ],
      "title": "TaskType",
      "type": "string"
    }
  },
  "$id": "https://ageneditor.local/schemas/task.v1.json",
  "additionalProperties": false,
  "properties": {
    "attempt_count": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "batch_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Batch Id",
      "type": "string"
    },
    "block_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/BlockReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Id"
    },
    "clip_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clip Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "cycle": {
      "default": 0,
      "maximum": 50,
      "minimum": 0,
      "title": "Cycle",
      "type": "integer"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "input_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Fingerprint"
    },
    "max_attempts": {
      "default": 3,
      "maximum": 10,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "not_before": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Not Before"
    },
    "params": {
      "additionalProperties": true,
      "title": "Params",
      "type": "object"
    },
    "priority": {
      "default": 50,
      "maximum": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus",
      "default": "created"
    },
    "type": {
      "$ref": "#/$defs/TaskType"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "writer": {
      "default": false,
      "title": "Writer",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "project_id",
    "batch_id",
    "type"
  ],
  "title": "Task",
  "type": "object"
}
