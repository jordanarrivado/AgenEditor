{
  "$defs": {
    "ModelPreset": {
      "enum": [
        "tiny",
        "base",
        "small"
      ],
      "title": "ModelPreset",
      "type": "string"
    },
    "SilenceCandidate": {
      "additionalProperties": false,
      "properties": {
        "after_word_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Word Id"
        },
        "before_word_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Before Word Id"
        },
        "end_us": {
          "exclusiveMinimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "method": {
          "const": "word_gap",
          "default": "word_gap",
          "title": "Method",
          "type": "string"
        },
        "start_us": {
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        }
      },
      "required": [
        "start_us",
        "end_us"
      ],
      "title": "SilenceCandidate",
      "type": "object"
    },
    "TranscriptSegment": {
      "additionalProperties": false,
      "properties": {
        "end_us": {
          "exclusiveMinimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "start_us": {
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "word_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Word Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "start_us",
        "end_us",
        "text",
        "word_ids"
      ],
      "title": "TranscriptSegment",
      "type": "object"
    },
    "TranscriptWord": {
      "additionalProperties": false,
      "properties": {
        "end_us": {
          "exclusiveMinimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "probability": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probability"
        },
        "segment_id": {
          "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
          "title": "Segment Id",
          "type": "string"
        },
        "start_us": {
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "timing": {
          "default": "aligned",
          "enum": [
            "aligned",
            "estimated"
          ],
          "title": "Timing",
          "type": "string"
        }
      },
      "required": [
        "id",
        "segment_id",
        "text",
        "start_us",
        "end_us"
      ],
      "title": "TranscriptWord",
      "type": "object"
    }
  },
  "$id": "https://ageneditor.local/schemas/transcript.v1.json",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Asset Id",
      "type": "string"
    },
    "compute": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compute"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "duration_us": {
      "exclusiveMinimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "language": {
      "maxLength": 32,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "language_probability": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language Probability"
    },
    "model_preset": {
      "$ref": "#/$defs/ModelPreset"
    },
    "model_version": {
      "maxLength": 100,
      "title": "Model Version",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[a-z0-9][a-z0-9_\\-]{0,63}$",
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/TranscriptSegment"
      },
      "title": "Segments",
      "type": "array"
    },
    "silence_candidates": {
      "items": {
        "$ref": "#/$defs/SilenceCandidate"
      },
      "title": "Silence Candidates",
      "type": "array"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/TranscriptWord"
      },
      "title": "Words",
      "type": "array"
    }
  },
  "required": [
    "id",
    "project_id",
    "asset_id",
    "source_sha256",
    "model_preset",
    "model_version",
    "language",
    "duration_us"
  ],
  "title": "Transcript",
  "type": "object"
}
